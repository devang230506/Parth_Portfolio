# Cal.com Booking Configuration
# Format: username/event-slug (e.g. "yourname/intro-call")
CAL_LINK=yourname/intro-call
CAL_NAMESPACE=intro

# Next.js / Universal compatibility
NEXT_PUBLIC_CAL_LINK=yourname/intro-call
NEXT_PUBLIC_CAL_NAMESPACE=intro

# Vite / Angular esbuild compatibility
VITE_CAL_LINK=yourname/intro-call
VITE_CAL_NAMESPACE=intro
